1. Flight Controller Script (player_ship.gd)
extends CharacterBody3D

@export var max_speed: float = 120.0
@export var acceleration: float = 45.0
@export var rotation_speed: float = 2.0
@export var damping: float = 3.5

var velocity_vector: Vector3 = Vector3.ZERO
var rotation_input: Vector3 = Vector3.ZERO

func _physics_process(delta: float) -> void:
    # Handle rotational input (Pitch, Yaw, Roll) using project input actions
    var target_rot = Vector3(
        Input.get_axis("pitch_down", "pitch_up"),
        Input.get_axis("yaw_right", "yaw_left"),
        Input.get_axis("roll_left", "roll_right")
    ) * rotation_speed
    
    rotation_input = rotation_input.lerp(target_rot, delta * 10.0)
    rotate_object_local(Vector3.RIGHT, rotation_input.x * delta)
    rotate_object_local(Vector3.UP, rotation_input.y * delta)
    rotate_object_local(Vector3.BACK, rotation_input.z * delta)

    # Handle thrust and linear movement vectors
    var thrust_dir = Vector3.ZERO
    if Input.is_action_pressed("thrust_forward"):
        thrust_dir -= transform.basis.z
    if Input.is_action_pressed("thrust_reverse"):
        thrust_dir += transform.basis.z
        
    thrust_dir = thrust_dir.normalized()
    
    # Apply acceleration and Newtonian space damping
    if thrust_dir != Vector3.ZERO:
        velocity_vector += thrust_dir * acceleration * delta
    else:
        velocity_vector = velocity_vector.move_toward(Vector3.ZERO, damping * delta)
        
    velocity_vector = velocity_vector.clampf(-max_speed, max_speed)
    velocity = velocity_vector
    move_and_slide()

